# Runtime API: Supabase transaction-pooler URL (usually port 6543).
# Keep this secret; never use it in VITE_ variables or browser code.
DATABASE_URL=postgresql://postgres.<project-ref>:<password>@<pooler-host>:6543/postgres?sslmode=require

# Schema migrations: Supabase direct URL (or session pooler if IPv4-only).
# Used locally by `pnpm db:push`; do not add this to Vercel unless needed.
DIRECT_URL=postgresql://postgres:<password>@db.<project-ref>.supabase.co:5432/postgres?sslmode=require

# One-time data import only: old Manus/MySQL source and new Supabase direct URL.
SOURCE_MYSQL_URL=mysql://<user>:<password>@<host>:3306/<database>
SUPABASE_DIRECT_URL=postgresql://postgres:<password>@db.<project-ref>.supabase.co:5432/postgres?sslmode=require

# Optional: preserve the Manus-based owner moderation login.
# Leave unset to run the public noodle game without the management login.
VITE_OAUTH_PORTAL_URL=
VITE_APP_ID=
OAUTH_SERVER_URL=
JWT_SECRET=
OWNER_OPEN_ID=
